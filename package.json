{
  "name": "nle-mediabunny-export-benchmarking",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "bench:server": "node bench-server/server.mjs",
    "bench": "npm run build && node bench/run.mjs",
    "test:ui": "npm run build && node bench/ui-smoke.mjs && node bench/effects-smoke.mjs",
    "bench:matrix": "npm run build && node bench/run.mjs --matrix",
    "bench:fx": "npm run build && node bench/fx-catalog.mjs",
    "test:bench-server": "node --test bench-server/probes.test.mjs bench-server/stats.test.mjs bench-server/sessions.test.mjs",
    "test:regress": "npm run build && node bench/regress.mjs && node bench/editor-regress.mjs && node --test bench/summary.test.mjs"
  },
  "dependencies": {
    "@mediabunny/aac-encoder": "^1.65.2",
    "@mediabunny/ac3": "^1.65.2",
    "@mediabunny/dts": "^1.65.2",
    "@mediabunny/flac-encoder": "^1.65.2",
    "@mediabunny/mp3-encoder": "^1.65.2",
    "@mediabunny/prores": "^1.65.2",
    "@mediabunny/truehd": "^1.65.2",
    "mediabunny": "^1.65.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "playwright": "^1.65.0",
    "vite": "^8.3.6"
  }
}
